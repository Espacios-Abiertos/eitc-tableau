      <aliases enabled='yes' />
      <column caption='credito_promedio' datatype='real' default-format='p0%' name='[% Monto EITC 2022 (copy)_3679792788975792128]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Crédito por Trabajo - Total])/SUM([Planillas Total - Crédito por Trabajo])' />
      </column>
      <column caption='% tier2 CTC' datatype='real' name='[%_tier2_CTC]' role='measure' type='quantitative' />
      <column caption='% tier3 CTC' datatype='real' name='[%_tier3_CTC]' role='measure' type='quantitative' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1eszyto0y7ct4i14hsxyb0ptm156].[cnt:unidad_contributiva:qk]&quot;' value='Unidades contributivas' />
          <alias key='&quot;[federated.1eszyto0y7ct4i14hsxyb0ptm156].[pcto:cnt:unidad_contributiva:qk]&quot;' value='% Unidades contributivas' />
          <alias key='&quot;[federated.1eszyto0y7ct4i14hsxyb0ptm156].[pcto:sum:monto_EITC_2022:qk]&quot;' value='% Monto EITC 2022' />
          <alias key='&quot;[federated.1eszyto0y7ct4i14hsxyb0ptm156].[pcto:sum:rev_monto_EITC_2019_oficial:qk]&quot;' value='% Monto EITC 2019' />
        </aliases>
      </column>
      <column caption='County' datatype='string' name='[COUNTY]' role='dimension' semantic-role='[County].[Name]' type='nominal' />
      <column caption='menos pobres debido al crédito' datatype='integer' name='[Calculation_1363183379889532931]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [status_pobreza_base] = &quot;Bajo (base)&quot;&#13;&#10;AND&#13;&#10;[status_pobreza_EITC_2022] = &quot;Bajo (beneficiarios EITC) (2022)&quot;&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='rebasarían umbral debido al crédito' datatype='integer' name='[Calculation_1363183379890442244]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [status_pobreza_base] = &quot;Bajo (base)&quot;&#13;&#10;AND&#13;&#10;[status_pobreza_EITC_2022] = &quot;Sobre (beneficiarios EITC) (2022)&quot;&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='sobre umbral previo al crédito' datatype='integer' name='[Calculation_1363183379890749445]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [status_pobreza_base] = &quot;Sobre (base)&quot;&#13;&#10;AND&#13;&#10;[status_pobreza_EITC_2022] = &quot;Sobre (beneficiarios EITC) (2022)&quot;&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='% Familias EITC 2022' datatype='real' default-format='p0%' name='[Calculation_1463106995393126400]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([beneficiario_EITC_2022])/COUNT([unidad_contributiva])' />
      </column>
      <column caption='% Monto EITC 2022' datatype='real' default-format='p0%' name='[Calculation_1463106995476062210]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([monto_EITC_2022])/SUM([ingreso_bruto_ajustado])' />
      </column>
      <column caption='% Familias EITC 2019' datatype='real' default-format='p0%' name='[Calculation_1463106995499626499]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rev_beneficiario_EITC_2019_oficial])/COUNT([unidad_contributiva])' />
      </column>
      <column caption='% Monto EITC 2019' datatype='real' default-format='p0%' name='[Calculation_1463106995499753476]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rev_monto_EITC_2019_oficial])/SUM([ingreso_bruto_ajustado])' />
      </column>
      <column caption='% Pobreza general' datatype='real' default-format='p0%' name='[Calculation_1528127648914059265]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([below_poverty_level])/SUM([total_population])' />
      </column>
      <column caption='% Pobreza infantil' datatype='real' default-format='p0%' name='[Calculation_1528127648915128324]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([under_18y_below_poverty_level])/SUM([under_18y_total_population])' />
      </column>
      <column caption='Personas EITC 2022' datatype='integer' name='[Calculation_305963366561394688]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([beneficiario_EITC_2022]=1,[miembros_unidad_contributiva],0))' />
      </column>
      <column caption='Personas EITC 2019' datatype='integer' name='[Calculation_305963366562705409]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([rev_beneficiario_EITC_2019_oficial]=1,[miembros_unidad_contributiva],0))' />
      </column>
      <column caption='Menores EITC 2019' datatype='integer' name='[Calculation_305963366566715397]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([rev_beneficiario_EITC_2019_oficial]=1,[numero_dependientes_eitc],0))' />
      </column>
      <column caption='Menores EITC 2022' datatype='integer' name='[Calculation_305963366566944774]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([beneficiario_EITC_2022]=1,[numero_dependientes_eitc],0))' />
      </column>
      <column caption='Métrica seleccionada (mapa EITC)' datatype='real' default-format='p0%' name='[Calculation_386183735427416064]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;% beneficiarios 2019&quot; THEN ([Calculation_1463106995499626499])&#13;&#10;WHEN &quot;% monto EITC 2019&quot; THEN ([Calculation_1463106995499753476])&#13;&#10;WHEN &quot;% beneficiarios EITC 2022&quot; THEN ([Calculation_1463106995393126400])&#13;&#10;WHEN &quot;% monto EITC 2022&quot; THEN ([Calculation_1463106995476062210])&#13;&#10;END' />
      </column>
      <column caption='Créditos por persona (EITC + CTC)' datatype='real' default-format='c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)' name='[Calculation_986569861101678592]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([monto_CTC_2022])+SUM([monto_EITC_2022]))/SUM([pop_2019_acs_5yr])' />
      </column>
      <column caption='Créditos (EITC + CTC)' datatype='real' default-format='c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)' name='[Calculation_986569861102501889]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_ctc_credit_lower_estimate])+SUM([Crédito por Trabajo - Total])' />
      </column>
      <column caption='Monto CTC (Total)' datatype='real' default-format='c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)' name='[Calculation_986569861117530115]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([monto_CTC_2022])' />
      </column>
      <column caption='Monto CTC  (0-5 años)' datatype='real' default-format='c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)' name='[Calculation_986569861117833221]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([rango_edad]=&quot;0_a_5&quot;,[monto_CTC_2022],0))' />
      </column>
      <column caption='Monto CTC (6-17 años)' datatype='real' default-format='c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)' name='[Calculation_986569861117992966]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([rango_edad]=&quot;6_a_17&quot;,[monto_CTC_2022],0))' />
      </column>
      <column caption='Título mapa EITC/CTC' datatype='string' name='[Calculation_986569861137326087]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF MIN([municipio (municipios!mapbox)])=MAX([municipio (municipios!mapbox)]) &#13;&#10;THEN MIN([municipio (municipios!mapbox)])&#13;&#10;ELSEIF AVG({COUNTD([municipio (municipios!mapbox)])})=COUNTD([municipio (municipios!mapbox)]) THEN &quot;Puerto Rico&quot;&#13;&#10;ELSE &quot;Varios municipios&quot;&#13;&#10;END' />
      </column>
